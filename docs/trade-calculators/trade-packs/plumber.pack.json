  "modifiers": [
    { "id": "emergency", "when": "urgency == 'emergency'", "factor": 1.75,
      "scope": ["labour"], "explain": "Emergency callout — dropping other work" },
    { "id": "same_day", "when": "urgency == 'same_day'", "factor": 1.35,
      "scope": ["labour"], "explain": "Same-day attendance" },
    { "id": "next_day", "when": "urgency == 'next_day'", "factor": 1.15,
      "scope": ["labour"], "explain": "Next-day attendance" },

    { "id": "evening", "when": "time_of_day == 'evening'", "factor": 1.5,
      "scope": ["labour"], "explain": "Out-of-hours working" },
    { "id": "weekend", "when": "time_of_day == 'weekend'", "factor": 1.5,
      "scope": ["labour"], "explain": "Weekend working" },
    { "id": "bank_holiday", "when": "time_of_day == 'bank_holiday'", "factor": 2.0,
      "scope": ["labour"], "explain": "Bank holiday working" },

    { "id": "access_concrete", "when": "pipework_access == 'concrete'", "factor": 2.4,
      "scope": ["pipework"], "explain": "Concrete floor — chasing or re-routing pipework" },
    { "id": "access_laminate", "when": "pipework_access == 'laminate'", "factor": 1.9,
      "scope": ["pipework"], "explain": "Laminate or engineered floor to lift and relay" },
    { "id": "access_floorboards", "when": "pipework_access == 'floorboards'", "factor": 1.5,
      "scope": ["pipework"], "explain": "Pipework under floorboards" },
    { "id": "access_loft", "when": "pipework_access == 'loft'", "factor": 1.4,
      "scope": ["pipework"], "explain": "Loft or crawl space — restricted working" },
    { "id": "access_boxed", "when": "pipework_access == 'boxed'", "factor": 1.3,
      "scope": ["pipework"], "explain": "Boxed-in pipework to open up" },
    { "id": "access_carpet", "when": "pipework_access == 'carpet'", "factor": 1.2,
      "scope": ["pipework"], "explain": "Carpet to lift and relay" },

    { "id": "old_property", "when": "property_age == 'pre_1960'", "factor": 1.20,
      "scope": ["labour"], "explain": "Pre-1960 property — legacy pipework and fittings" },
    { "id": "legacy_pipe", "when": "existing_pipe == 'lead' || existing_pipe == 'galvanised'",
      "factor": 1.35, "scope": ["pipework"],
      "explain": "Lead or galvanised pipe — transition fittings and extra care" },
    { "id": "imperial_pipe", "when": "existing_pipe == 'imperial'", "factor": 1.15,
      "scope": ["pipework"], "explain": "Imperial copper — adaptors needed throughout" },

    { "id": "upper_floor_no_lift", "when": "floor_level > 2 && property_type == 'flat'",
      "factor": 1.12, "scope": ["handling"], "explain": "Upper floor — carrying materials up" },
    { "id": "client_supplied_fixtures", "when": "fixtures_client_supplied > 0", "factor": 1.08,
      "scope": ["labour"], "explain": "Client-supplied fixtures — fit issues and missing parts" }
  ],

  "extras": [
    { "id": "gas_notification", "label": "Building Regulations notification (gas)",
      "pricing": { "type": "fixed", "sku": "cert.gas.notification" },
      "when": "is_gas_job", "group": "Certification" },
    { "id": "benchmark", "label": "Benchmark commissioning",
      "pricing": { "type": "fixed", "sku": "cert.benchmark" },
      "when": "boiler_work != 'none'", "group": "Certification" },
    { "id": "landlord_cert", "label": "Landlord Gas Safety Record",
      "pricing": { "type": "fixed", "sku": "cert.landlord.gas" },
      "when": "job_type == 'landlord_check'", "group": "Certification" },
    { "id": "g3_notification", "label": "G3 unvented notification",
      "pricing": { "type": "fixed", "sku": "cert.g3.notification" },
      "when": "cylinder_work == 'unvented_install'", "group": "Certification" },
    { "id": "wras_notification", "label": "Water Regs notification",
      "pricing": { "type": "fixed", "sku": "cert.wras.notification" },
      "when": "cylinder_work == 'unvented_install'", "group": "Certification" },
    { "id": "electrician", "label": "Electrician — Part P notifiable work",
      "pricing": { "type": "fixed", "sku": "subcontract.electrician.day" },
      "when": "part_p_route == 'subcontract'", "group": "Certification",
      "excludeFromMarginBase": true },
    { "id": "tip_fees", "label": "Disposal of old items",
      "pricing": { "type": "banded", "quantity": "waste_item_count", "bands": [
        { "upTo": 1, "sku": "disposal.single_item" },
        { "upTo": 3, "sku": "disposal.part_load" },
        { "upTo": 99, "sku": "disposal.full_load" } ] },
      "when": "waste_item_count > 0", "group": "Extras" },
    { "id": "congestion", "label": "Congestion / ULEZ charge",
      "pricing": { "type": "fixed", "sku": "travel.congestion", "multiplier": "visits" },
      "when": "parking == 'congestion'", "group": "Extras" },
    { "id": "parking_permit", "label": "Parking permit",
      "pricing": { "type": "fixed", "sku": "travel.permit", "multiplier": "visits" },
      "when": "parking == 'restricted'", "group": "Extras" }
  ],

  "risk": {
    "surveyConfidence": { "visited": 0, "photos": 0.10, "phone": 0.22 },
    "unknownConditions": [
      { "when": "property_age == 'pre_1960'", "add": 0.15,
        "explain": "Pre-1960 property — what's behind the wall is anyone's guess" },
      { "when": "pipe_material_unknown", "add": 0.12,
        "explain": "Existing pipe material unconfirmed" },
      { "when": "pipework_access == 'boxed' || pipework_access == 'concrete'", "add": 0.12,
        "explain": "Pipework not visible until opened up" },
      { "when": "system_type == 'unknown'", "add": 0.10,
        "explain": "System type unconfirmed" },
      { "when": "fixtures_client_supplied > 0", "add": 0.08,
        "explain": "Client-supplied fixtures — no warranty recourse, parts may not fit" }
    ],
    "cap": 0.35,
    "priceVolatility": { "low": 0, "medium": 0.03, "high": 0.06 }
  },

  "defaults": { "contingencyStance": "balanced", "minimumIncrementHours": 0.5 },

  "validation": [
    { "level": "error", "when": "asbestos_risk",
      "message": "Asbestos suspected. This needs a survey before anyone opens anything up — don't quote it yet." },
    { "level": "error", "when": "is_gas_job && !settings.registrations.gas_safe",
      "message": "Gas work requires Gas Safe registration. Add your number in Settings or quote this as subcontracted." },
    { "level": "error", "when": "cylinder_work == 'unvented_install' && !settings.registrations.g3",
      "message": "Unvented cylinder work requires a G3 qualification." },
    { "level": "error", "when": "fixture_count == 0 && rad_total == 0 && pipe_length_total == 0 && boiler_work == 'none' && cylinder_work == 'none' && job_type != 'callout_repair' && job_type != 'emergency' && job_type != 'landlord_check'",
      "message": "Nothing selected to price — add fixtures, radiators or pipework." },

    { "level": "warning", "when": "!making_good_selected && (chasing_metres > 0 || fixture_move_units > 0)",
      "message": "You're chasing walls or moving fixtures but making good isn't priced. It will print as an exclusion — make sure the client reads it." },
    { "level": "warning", "when": "urgency == 'emergency' && time_of_day == 'normal' && achieved_margin < 0.30",
      "message": "Emergency job at close to normal rates. Emergency work should carry its premium." },
    { "level": "warning", "when": "total_price_pence > 150000 && !has_staged_payments",
      "message": "Over £1,500 with no staged payments. Take a deposit for materials at least." },
    { "level": "warning", "when": "pipe_length_total > 0 && isolation_valves_count == 0",
      "message": "No isolation valves in the materials list. You'll want them." },
    { "level": "warning", "when": "modifier_cap_hit",
      "message": "This job hit the difficulty cap. Worth opening something up before you commit to a price." },
    { "level": "warning", "when": "effective_hourly_pence < settings.labour_cost_pence",
      "message": "You're charging less per hour than the work costs you. This job loses money." }
  ],

  "presentation": {
    "groups": ["Strip out and disposal", "First fix", "Fixtures and second fix", "Materials", "Certification", "Extras"],
    "exclusions": [
      "Making good — plastering, tiling, boxing in or decorating — unless stated above",
      "Electrical work, including bonding and fused spurs, unless stated above",
      "Any work arising from conditions found once floors, walls or panels are opened up",
      "Removal or handling of asbestos-containing materials",
      "Repair or replacement of pipework beyond the sections stated above",
      "Builder's work, structural alterations and reinstatement of concealed finishes"
    ],
    "assumptions": [
      "Mains water can be isolated at a working stopcock",
      "Reasonable access to the work area and to pipework runs",
      "Water and electricity available on site",
      "Fixtures and appliances are on site before the fitting visit",
      "The property is free of asbestos in the areas being worked on"
    ],
    "validityDays": 30,
    "printRegistrations": ["gas_safe", "g3", "part_p"]
  }
}
