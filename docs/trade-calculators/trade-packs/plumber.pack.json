{
  "id": "plumber",
  "specVersion": 2,
  "packVersion": "1.0.0-draft",
  "name": "The Plumber's Pricing Calculator",
  "region": "GB",
  "units": "metric",

  "jobTypes": [
    { "id": "callout_repair", "label": "Callout or repair", "icon": "wrench",
      "asks": ["context", "access", "repair"], "minimum": "callout" },
    { "id": "bathroom_install", "label": "Bathroom installation", "icon": "bath",
      "asks": ["context", "access", "fixtures", "pipework", "making_good"], "minimum": "day",
      "visits": 2 },
    { "id": "boiler", "label": "Boiler swap or install", "icon": "flame",
      "asks": ["context", "access", "boiler", "certification"], "minimum": "day",
      "requires": ["registrations.gas_safe"],
      "requiresMessage": "Boiler work is Gas Safe registered only. Add your Gas Safe number in Settings, or quote this as a subcontracted job." },
    { "id": "radiator_work", "label": "Radiators", "icon": "radiator",
      "asks": ["context", "access", "radiators", "pipework"], "minimum": "half_day" },
    { "id": "kitchen_plumbing", "label": "Kitchen plumbing", "icon": "sink",
      "asks": ["context", "access", "fixtures", "pipework"], "minimum": "half_day" },
    { "id": "pipework", "label": "Pipework or re-pipe", "icon": "pipe",
      "asks": ["context", "access", "pipework"], "minimum": "half_day" },
    { "id": "unvented_cylinder", "label": "Unvented cylinder", "icon": "cylinder",
      "asks": ["context", "access", "cylinder", "certification"], "minimum": "day",
      "requires": ["registrations.g3"],
      "requiresMessage": "Unvented cylinders require a G3 qualification. Add your G3 number in Settings." },
    { "id": "emergency", "label": "Emergency", "icon": "alert",
      "asks": ["context", "access", "repair"], "minimum": "callout",
      "defaults": { "urgency": "emergency" } },
    { "id": "landlord_check", "label": "Landlord safety check", "icon": "shield",
      "asks": ["context", "certification"], "minimum": "callout",
      "requires": ["registrations.gas_safe"],
      "requiresMessage": "A Landlord Gas Safety Record can only be issued by a Gas Safe registered engineer." }
  ],

  "questions": [
    { "id": "urgency", "label": "How soon?", "type": "enum", "control": "cards",
      "group": "context", "default": "booked_in",
      "options": [
        { "value": "booked_in", "label": "Booked in", "sub": "Normal lead time" },
        { "value": "next_day", "label": "Next day" },
        { "value": "same_day", "label": "Same day" },
        { "value": "emergency", "label": "Emergency", "sub": "Drop everything" }
      ] },

    { "id": "time_of_day", "label": "When are you working?", "type": "enum",
      "control": "segmented", "group": "context", "default": "normal",
      "options": [
        { "value": "normal", "label": "Normal hours" },
        { "value": "evening", "label": "Evening" },
        { "value": "weekend", "label": "Weekend" },
        { "value": "bank_holiday", "label": "Bank holiday" }
      ] },

    { "id": "property_type", "label": "What kind of property?", "type": "enum",
      "control": "cards", "group": "context", "default": "house",
      "options": [
        { "value": "flat", "label": "Flat" },
        { "value": "house", "label": "House" },
        { "value": "hmo", "label": "HMO" },
        { "value": "commercial", "label": "Commercial" }
      ] },

    { "id": "property_age", "label": "Roughly how old is it?", "type": "enum",
      "control": "segmented", "group": "context", "default": "1960_2000",
      "help": "The biggest single driver of plumbing surprises.",
      "options": [
        { "value": "pre_1960", "label": "Pre-1960", "sub": "Lead or imperial pipe possible" },
        { "value": "1960_2000", "label": "1960–2000" },
        { "value": "post_2000", "label": "Post-2000" }
      ] },

    { "id": "system_type", "label": "What system is in there?", "type": "enum",
      "control": "cards", "group": "context", "default": "combi",
      "options": [
        { "value": "combi", "label": "Combi" },
        { "value": "system", "label": "System + cylinder" },
        { "value": "gravity", "label": "Gravity / vented", "sub": "Tank in the loft" },
        { "value": "unvented", "label": "Unvented" },
        { "value": "unknown", "label": "Not sure yet" }
      ] },

    { "id": "asbestos_risk", "label": "Any asbestos suspected?", "type": "boolean",
      "control": "toggle", "group": "context", "default": false,
      "help": "Artex, old flue runs, boiler bases in pre-2000 properties." },

    { "id": "stopcock", "label": "Stopcock — found and working?", "type": "enum",
      "control": "segmented", "group": "context", "default": "working",
      "options": [
        { "value": "working", "label": "Yes" },
        { "value": "seized", "label": "Seized" },
        { "value": "not_found", "label": "Can't find it" }
      ] },

    { "id": "isolation_possible", "label": "Can you isolate without draining the system?",
      "type": "boolean", "control": "toggle", "group": "context", "default": true },

    { "id": "surveyed", "label": "Have you seen the job?", "type": "enum",
      "control": "segmented", "group": "context", "default": "visited",
      "options": [
        { "value": "visited", "label": "Been there" },
        { "value": "photos", "label": "Photos only" },
        { "value": "phone", "label": "Described on the phone" }
      ] },

    { "id": "parking", "label": "Parking", "type": "enum", "control": "segmented",
      "group": "context", "default": "outside",
      "options": [
        { "value": "outside", "label": "Outside" },
        { "value": "under_50m", "label": "Under 50 m" },
        { "value": "restricted", "label": "Restricted", "sub": "Permit needed" },
        { "value": "congestion", "label": "Congestion / ULEZ zone" }
      ] },

    { "id": "floor_level", "label": "Which floor?", "type": "count", "control": "stepper",
      "group": "context", "default": 0, "min": 0, "max": 20 },

    { "id": "pipework_access", "label": "How do you get at the pipework?", "type": "enum",
      "control": "cards", "group": "access", "default": "floorboards",
      "affects": ["pipe_run", "fixture_pipework"],
      "options": [
        { "value": "exposed", "label": "Exposed", "sub": "Straight at it" },
        { "value": "boxed", "label": "Boxed in" },
        { "value": "carpet", "label": "Under carpet" },
        { "value": "floorboards", "label": "Under floorboards" },
        { "value": "laminate", "label": "Under laminate or engineered", "sub": "Has to come up carefully" },
        { "value": "concrete", "label": "Concrete floor", "sub": "Chasing or re-routing" },
        { "value": "loft", "label": "Loft or crawl space" }
      ] },

    { "id": "existing_pipe", "label": "What's the existing pipe?", "type": "enum",
      "control": "cards", "group": "access", "default": "copper",
      "options": [
        { "value": "copper", "label": "Copper" },
        { "value": "plastic", "label": "Plastic" },
        { "value": "imperial", "label": "Imperial copper", "sub": "Needs adaptors" },
        { "value": "lead", "label": "Lead", "sub": "Replace back to the main" },
        { "value": "galvanised", "label": "Galvanised steel" },
        { "value": "unknown", "label": "Won't know until I open up" }
      ] },

    { "id": "chasing_metres", "label": "Wall chasing needed", "type": "number", "unit": "m",
      "control": "slider", "group": "access", "default": 0, "min": 0, "max": 30, "step": 0.5 },

    { "id": "joists_crossed", "label": "Joists to drill", "type": "count",
      "control": "stepper", "group": "access", "default": 0 },

    { "id": "fixtures", "label": "Fixtures", "type": "repeater", "control": "repeater",
      "group": "fixtures", "minItems": 0, "duplicateLabel": "Add another",
      "fields": [
        { "id": "fixture_type", "label": "Fixture", "type": "enum", "control": "chips",
          "default": "basin",
          "options": [
            { "value": "basin", "label": "Basin" },
            { "value": "wc_close_coupled", "label": "WC — close coupled" },
            { "value": "wc_concealed", "label": "WC — concealed cistern" },
            { "value": "bath", "label": "Bath" },
            { "value": "shower_mixer", "label": "Shower over bath" },
            { "value": "shower_enclosure", "label": "Shower enclosure + tray" },
            { "value": "kitchen_sink", "label": "Kitchen sink" },
            { "value": "utility_sink", "label": "Utility sink" },
            { "value": "outside_tap", "label": "Outside tap" },
            { "value": "tap_only", "label": "Taps only" },
            { "value": "appliance", "label": "Appliance connection" }
          ] },
        { "id": "count", "label": "How many", "type": "count", "control": "stepper", "default": 1 },
        { "id": "supply", "label": "Who supplies it?", "type": "enum", "control": "segmented",
          "default": "plumber",
          "options": [
            { "value": "plumber", "label": "I do" },
            { "value": "client", "label": "Client does" }
          ] },
        { "id": "position", "label": "Position", "type": "enum", "control": "segmented",
          "default": "same",
          "options": [
            { "value": "same", "label": "Same spot" },
            { "value": "moved_lt1", "label": "Moved under 1 m" },
            { "value": "moved_gt1", "label": "Moved over 1 m" },
            { "value": "new", "label": "Brand new position" }
          ] },
        { "id": "seized", "label": "Seized or awkward?", "type": "boolean",
          "control": "toggle", "default": false }
      ] },

    { "id": "rad_swap", "label": "Radiator swaps (like for like)", "type": "count",
      "control": "stepper", "group": "radiators", "default": 0 },
    { "id": "rad_new_existing", "label": "New radiators on existing pipework", "type": "count",
      "control": "stepper", "group": "radiators", "default": 0 },
    { "id": "rad_new_pipework", "label": "New radiators + new pipework", "type": "count",
      "control": "stepper", "group": "radiators", "default": 0 },
    { "id": "trv_count", "label": "TRVs and valves", "type": "count",
      "control": "stepper", "group": "radiators", "default": 0 },

    { "id": "pipe_runs", "label": "Pipe runs", "type": "repeater", "control": "repeater",
      "group": "pipework", "minItems": 0,
      "fields": [
        { "id": "length", "label": "Length", "type": "number", "unit": "m",
          "control": "slider", "default": 5, "min": 0.5, "max": 60, "step": 0.5 },
        { "id": "material", "label": "Material", "type": "enum", "control": "segmented",
          "default": "copper",
          "options": [
            { "value": "copper", "label": "Copper" },
            { "value": "pushfit", "label": "Push-fit" },
            { "value": "pex", "label": "PEX" },
            { "value": "mlcp", "label": "MLCP" }
          ] },
        { "id": "diameter", "label": "Diameter", "type": "enum", "control": "segmented",
          "default": "15",
          "options": [
            { "value": "15", "label": "15 mm" },
            { "value": "22", "label": "22 mm" },
            { "value": "28", "label": "28 mm" }
          ] },
        { "id": "bends", "label": "Bends", "type": "count", "control": "stepper", "default": 0 },
        { "id": "tees", "label": "Tees", "type": "count", "control": "stepper", "default": 0 }
      ] },

    { "id": "boiler_work", "label": "Boiler", "type": "enum", "control": "cards",
      "group": "boiler", "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "like_for_like", "label": "Combi swap, like for like" },
        { "value": "conversion", "label": "System to combi conversion" },
        { "value": "relocate", "label": "Relocate" },
        { "value": "new_install", "label": "New installation" }
      ] },

    { "id": "boiler_supply", "label": "Who supplies the boiler?", "type": "enum",
      "control": "segmented", "group": "boiler", "default": "plumber",
      "appliesWhen": "boiler_work != 'none'",
      "options": [
        { "value": "plumber", "label": "I do" },
        { "value": "client", "label": "Client does" }
      ] },

    { "id": "powerflush", "label": "Powerflush", "type": "boolean", "control": "toggle",
      "group": "boiler", "default": false },
    { "id": "powerflush_rads", "label": "Radiators to flush", "type": "count",
      "control": "stepper", "group": "boiler", "default": 8, "appliesWhen": "powerflush" },

    { "id": "cylinder_work", "label": "Cylinder", "type": "enum", "control": "cards",
      "group": "cylinder", "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "vented_swap", "label": "Vented swap" },
        { "value": "unvented_install", "label": "Unvented install" },
        { "value": "remove", "label": "Remove" }
      ] },

    { "id": "leak_detection", "label": "Leak with no visible source?", "type": "boolean",
      "control": "toggle", "group": "repair", "default": false },

    { "id": "repair_hours_estimate", "label": "How long do you reckon?", "type": "number",
      "unit": "hr", "control": "slider", "group": "repair", "default": 1,
      "min": 0.5, "max": 8, "step": 0.5,
      "help": "Your own read of the job. The minimum callout still applies." },

    { "id": "making_good", "label": "Making good", "type": "multi_enum", "control": "chips",
      "group": "making_good", "default": [],
      "help": "Anything not ticked here prints as an exclusion. This is where plumbing jobs go wrong.",
      "options": [
        { "value": "plastering", "label": "Plastering" },
        { "value": "tiling", "label": "Tiling" },
        { "value": "boxing", "label": "Boxing in" },
        { "value": "decorating", "label": "Decorating" }
      ] },

    { "id": "waste_items", "label": "Old items to take away", "type": "multi_enum",
      "control": "chips", "group": "making_good", "default": [],
      "options": [
        { "value": "bath", "label": "Bath" },
        { "value": "wc", "label": "WC and basin" },
        { "value": "cylinder", "label": "Cylinder" },
        { "value": "boiler", "label": "Boiler" },
        { "value": "radiators", "label": "Radiators" }
      ] },

    { "id": "part_p_route", "label": "Electrical work", "type": "enum", "control": "cards",
      "group": "certification", "default": "none",
      "options": [
        { "value": "none", "label": "None needed" },
        { "value": "subcontract", "label": "Subcontract to an electrician" },
        { "value": "self_certify", "label": "I self-certify (Part P)" }
      ] }
  ],

  "derivations": [
    { "id": "basin_count", "expr": "sum(fixtures, if(f.fixture_type == 'basin', f.count, 0))" },
    { "id": "wc_cc_count", "expr": "sum(fixtures, if(f.fixture_type == 'wc_close_coupled', f.count, 0))" },
    { "id": "wc_conc_count", "expr": "sum(fixtures, if(f.fixture_type == 'wc_concealed', f.count, 0))" },
    { "id": "bath_count", "expr": "sum(fixtures, if(f.fixture_type == 'bath', f.count, 0))" },
    { "id": "shower_mixer_count", "expr": "sum(fixtures, if(f.fixture_type == 'shower_mixer', f.count, 0))" },
    { "id": "shower_encl_count", "expr": "sum(fixtures, if(f.fixture_type == 'shower_enclosure', f.count, 0))" },
    { "id": "sink_count", "expr": "sum(fixtures, if(f.fixture_type == 'kitchen_sink' || f.fixture_type == 'utility_sink', f.count, 0))" },
    { "id": "outside_tap_count", "expr": "sum(fixtures, if(f.fixture_type == 'outside_tap', f.count, 0))" },
    { "id": "appliance_count", "expr": "sum(fixtures, if(f.fixture_type == 'appliance', f.count, 0))" },
    { "id": "tap_count_easy", "expr": "sum(fixtures, if(f.fixture_type == 'tap_only' && !f.seized, f.count, 0))" },
    { "id": "tap_count_seized", "expr": "sum(fixtures, if(f.fixture_type == 'tap_only' && f.seized, f.count, 0))" },

    { "id": "fixture_count", "expr": "sum(fixtures, f.count)" },
    { "id": "fixtures_client_supplied", "expr": "sum(fixtures, if(f.supply == 'client', f.count, 0))" },

    { "id": "fixture_move_units",
      "expr": "sum(fixtures, f.count * if(f.position == 'same', 0, if(f.position == 'moved_lt1', 1, if(f.position == 'moved_gt1', 2, 3))))",
      "note": "Repositioning weight. Nested if() stands in for a lookup table — see spec v2 note on match()." },

    { "id": "pipe_length_copper", "expr": "sum(pipe_runs, if(p.material == 'copper', p.length, 0))" },
    { "id": "pipe_length_plastic", "expr": "sum(pipe_runs, if(p.material != 'copper', p.length, 0))" },
    { "id": "pipe_length_total", "expr": "pipe_length_copper + pipe_length_plastic" },
    { "id": "pipe_15mm", "expr": "sum(pipe_runs, if(p.diameter == '15', p.length, 0))" },
    { "id": "pipe_22mm", "expr": "sum(pipe_runs, if(p.diameter == '22', p.length, 0))" },
    { "id": "pipe_28mm", "expr": "sum(pipe_runs, if(p.diameter == '28', p.length, 0))" },
    { "id": "fittings_declared", "expr": "sum(pipe_runs, p.bends + p.tees)" },
    { "id": "fittings_estimated", "expr": "ceil(pipe_length_total * 0.85)" },
    { "id": "fittings_count", "expr": "max(fittings_declared, if(fittings_declared == 0, fittings_estimated, fittings_declared))",
      "note": "Fall back to an estimate when the user hasn't counted bends and tees." },

    { "id": "rad_total", "expr": "rad_swap + rad_new_existing + rad_new_pipework" },
    { "id": "is_gas_job", "expr": "boiler_work != 'none' || job_type == 'landlord_check'" },
    { "id": "needs_drain_down", "expr": "!isolation_possible || rad_new_pipework > 0 || boiler_work != 'none'" },
    { "id": "stopcock_remedial_units", "expr": "if(stopcock == 'working', 0, 1)" },
    { "id": "heavy_lift_units", "expr": "bath_count + if(cylinder_work != 'none', 1, 0) + if(boiler_work != 'none', 1, 0)" },
    { "id": "visits", "expr": "if(job_type == 'bathroom_install', 2, 1)" },
    { "id": "extra_visits", "expr": "visits - 1" },
    { "id": "unheated_pipe_length", "expr": "if(pipework_access == 'loft', pipe_length_total, pipe_length_total * 0.25)" },
    { "id": "making_good_selected", "expr": "count(making_good) > 0" },
    { "id": "waste_item_count", "expr": "count(waste_items)" },
    { "id": "pipe_material_unknown", "expr": "existing_pipe == 'unknown' || existing_pipe == 'lead' || existing_pipe == 'galvanised' || existing_pipe == 'imperial'" }
  ],

  "tasks": [
    { "id": "callout_diagnostic", "label": "Callout and diagnosis",
      "group": "First fix", "tags": ["labour", "callout"], "quantity": "repair_hours_estimate",
      "rate": { "low": 1.0, "typical": 1.0, "high": 1.0, "unit": "hr/hr" },
      "minHours": 1.0, "appliesWhen": "job_type == 'callout_repair' || job_type == 'emergency'",
      "source": "trade norm — 1 hr minimum then 30-minute increments" },

    { "id": "leak_detection", "label": "Leak detection",
      "group": "First fix", "tags": ["labour"], "quantity": "1",
      "rate": { "low": 1.0, "typical": 2.0, "high": 4.0, "unit": "hr" },
      "appliesWhen": "leak_detection", "source": "practitioner review 2026-02" },

    { "id": "strip_out", "label": "Strip out existing",
      "group": "Strip out and disposal", "tags": ["labour", "handling"], "quantity": "1",
      "rate": { "low": 3.0, "typical": 5.0, "high": 8.0, "unit": "hr" },
      "appliesWhen": "job_type == 'bathroom_install'", "source": "practitioner review 2026-02" },

    { "id": "first_fix", "label": "First fix pipework",
      "group": "First fix", "tags": ["labour", "pipework"], "quantity": "1",
      "rate": { "low": 6.0, "typical": 9.0, "high": 14.0, "unit": "hr" },
      "appliesWhen": "job_type == 'bathroom_install'", "source": "practitioner review 2026-02" },

    { "id": "second_fix", "label": "Second fix",
      "group": "Fixtures and second fix", "tags": ["labour"], "quantity": "1",
      "rate": { "low": 5.0, "typical": 8.0, "high": 12.0, "unit": "hr" },
      "appliesWhen": "job_type == 'bathroom_install'", "source": "practitioner review 2026-02" },

    { "id": "fit_basin", "label": "Basin — supply and fit",
      "group": "Fixtures and second fix", "tags": ["labour"], "quantity": "basin_count",
      "rate": { "low": 1.8, "typical": 2.5, "high": 4.0, "unit": "hr/each" },
      "appliesWhen": "job_type != 'bathroom_install'", "source": "practitioner review 2026-02" },

    { "id": "fit_wc_cc", "label": "WC — close coupled",
      "group": "Fixtures and second fix", "tags": ["labour"], "quantity": "wc_cc_count",
      "rate": { "low": 1.5, "typical": 2.2, "high": 3.5, "unit": "hr/each" },
      "appliesWhen": "job_type != 'bathroom_install'", "source": "practitioner review 2026-02" },

    { "id": "fit_wc_concealed", "label": "WC — concealed cistern",
      "group": "Fixtures and second fix", "tags": ["labour"], "quantity": "wc_conc_count",
      "rate": { "low": 3.0, "typical": 4.5, "high": 6.5, "unit": "hr/each" },
      "appliesWhen": "job_type != 'bathroom_install'", "source": "practitioner review 2026-02" },

    { "id": "fit_bath", "label": "Bath — supply and fit",
      "group": "Fixtures and second fix", "tags": ["labour", "handling"], "quantity": "bath_count",
      "rate": { "low": 3.0, "typical": 4.5, "high": 7.0, "unit": "hr/each" },
      "appliesWhen": "job_type != 'bathroom_install'", "source": "practitioner review 2026-02" },

    { "id": "fit_shower_mixer", "label": "Shower over bath",
      "group": "Fixtures and second fix", "tags": ["labour"], "quantity": "shower_mixer_count",
      "rate": { "low": 1.5, "typical": 2.5, "high": 4.0, "unit": "hr/each" },
      "appliesWhen": "job_type != 'bathroom_install'", "source": "practitioner review 2026-02" },

    { "id": "fit_shower_enclosure", "label": "Shower enclosure, tray and waste",
      "group": "Fixtures and second fix", "tags": ["labour"], "quantity": "shower_encl_count",
      "rate": { "low": 5.0, "typical": 7.5, "high": 12.0, "unit": "hr/each" },
      "appliesWhen": "job_type != 'bathroom_install'", "source": "practitioner review 2026-02" },

    { "id": "fit_sink", "label": "Sink — supply and fit",
      "group": "Fixtures and second fix", "tags": ["labour"], "quantity": "sink_count",
      "rate": { "low": 1.5, "typical": 2.2, "high": 3.5, "unit": "hr/each" },
      "source": "practitioner review 2026-02" },

    { "id": "fit_tap_easy", "label": "Tap replacement",
