        "when": "property_age == 'pre_1966'",
        "add": 0.18,
        "explain": "Pre-1966 — cable condition unknown until you open up"
      },
      {
        "when": "cable_unknown",
        "add": 0.15,
        "explain": "Existing cable type not established"
      },
      {
        "when": "earthing == 'unknown'",
        "add": 0.12,
        "explain": "Earthing arrangement not established"
      },
      {
        "when": "!as_built_available",
        "add": 0.1,
        "explain": "No as-built information — routes are guesswork"
      },
      {
        "when": "bonding == 'unknown'",
        "add": 0.08,
        "explain": "Bonding not checked — remedials likely"
      },
      {
        "when": "occupied",
        "add": 0.08,
        "explain": "Occupied property — access to rooms is not guaranteed"
      }
    ],
    "cap": 0.35,
    "priceVolatility": {
      "low": 0,
      "medium": 0.03,
      "high": 0.06
    }
  },
  "defaults": {
    "contingencyStance": "balanced"
  },
  "validation": [
    {
      "level": "error",
      "when": "is_notifiable && sub_region == 'england_wales' && !settings.registrations.part_p_scheme && part_p_route == 'self_certify'",
      "message": "You're not registered with a Part P scheme, so you can't self-certify. Switch to building control notification — the fee is added to the quote."
    },
    {
      "level": "error",
      "when": "point_count == 0 && new_circuit_count == 0 && !cu_replacement && job_type != 'eicr' && job_type != 'fault_finding'",
      "message": "Nothing to price — add points, circuits or a board change."
    },
    {
      "level": "warning",
      "when": "cu_replacement && bonding == 'unknown'",
      "message": "Board change with bonding unchecked. Bonding upgrades are the most commonly missed cost on a CU change."
    },
    {
      "level": "warning",
      "when": "job_type == 'ev_charger' && earthing == 'tncs' && !ev_open_device && !needs_earth_rod",
      "message": "EV on PME with no O-PEN device and no earth rod priced. One of the two is required."
    },
    {
      "level": "warning",
      "when": "load_check_missing",
      "message": "You're adding load without a main fuse rating. Check maximum demand before you commit to this."
    },
    {
      "level": "warning",
      "when": "is_rewire && point_count > 0 && (price_per_point < 5500 || price_per_point > 11000)",
      "message": "Rewire is pricing outside the usual £55–110 per point. Check the point count and the spec."
    },
    {
      "level": "warning",
      "when": "!making_good_selected && chasing_metres > 0",
      "message": "You're chasing walls but making good isn't priced. It will print as an exclusion."
    },
    {
      "level": "warning",
      "when": "cable_type == 'rubber' && !is_rewire",
      "message": "Rubber or VIR cable found and this isn't a rewire. Adding to an installation like that is a rewire conversation, not a repair."
    },
    {
      "level": "warning",
      "when": "modifier_cap_hit",
      "message": "This job hit the difficulty cap. Worth a proper survey before you send it."
    },
    {
      "level": "warning",
      "when": "effective_hourly_pence < settings.labour_cost_pence",
      "message": "You're charging less per hour than the work costs you."
    }
  ],
  "presentation": {
    "groups": [
      "Consumer unit and supply",
      "First fix",
      "Second fix",
      "Circuits",
      "Testing and certification",
      "Materials",
      "Extras"
    ],
    "exclusions": [
      "Making good — plastering, filling or redecoration — unless stated above",
      "Remedial work arising from defects found during inspection and testing",
      "Removal or disturbance of asbestos-containing materials",
      "Builder's work, lifting of fitted floor coverings, or removal of fitted furniture",
      "Supply upgrades or works carried out by the DNO",
      "Repair of concealed cabling, pipework or structure damaged during routing"
    ],
    "assumptions": [
      "Reasonable access to all rooms, the consumer unit and cable routes",
      "The existing installation is as described and free of undeclared defects",
      "Power may be interrupted during working hours",
      "Fitted floor coverings are lifted and relaid by others unless stated",
      "The property is free of asbestos in the areas being worked on"
    ],
    "validityDays": 30,
    "printRegistrations": [
      "part_p_scheme",
      "inspection_testing"
    ]
  }
}
