  "derivations": [
    {
      "id": "point_count",
      "expr": "sum(points, p.count)"
    },
    {
      "id": "points_existing_box",
      "expr": "sum(points, if(p.mounting == 'existing_box', p.count, 0))"
    },
    {
      "id": "points_surface",
      "expr": "sum(points, if(p.mounting == 'new_surface', p.count, 0))"
    },
    {
      "id": "points_chased",
      "expr": "sum(points, if(p.mounting == 'new_chased', p.count, 0))"
    },
    {
      "id": "points_drylined",
      "expr": "sum(points, if(p.mounting == 'new_drylined', p.count, 0))"
    },
    {
      "id": "downlight_count",
      "expr": "sum(points, if(p.point_type == 'downlight', p.count, 0))"
    },
    {
      "id": "alarm_count",
      "expr": "sum(points, if(p.point_type == 'alarm', p.count, 0))"
    },
    {
      "id": "extractor_count",
      "expr": "sum(points, if(p.point_type == 'extractor', p.count, 0))"
    },
    {
      "id": "standard_point_count",
      "expr": "point_count - downlight_count - alarm_count - extractor_count"
    },
    {
      "id": "new_circuit_count",
      "expr": "sum(new_circuits, c.count)"
    },
    {
      "id": "circuit_ring",
      "expr": "sum(new_circuits, if(c.circuit_type == 'ring', c.count, 0))"
    },
    {
      "id": "circuit_lighting",
      "expr": "sum(new_circuits, if(c.circuit_type == 'lighting', c.count, 0))"
    },
    {
      "id": "circuit_appliance",
      "expr": "sum(new_circuits, if(c.circuit_type == 'cooker' || c.circuit_type == 'shower' || c.circuit_type == 'radial' || c.circuit_type == 'outbuilding', c.count, 0))"
    },
    {
      "id": "cable_clipped",
      "expr": "sum(cable_runs, if(r.route == 'clipped', r.length, 0))"
    },
    {
      "id": "cable_fished",
      "expr": "sum(cable_runs, if(r.route == 'fished', r.length, 0))"
    },
    {
      "id": "cable_swa",
      "expr": "sum(cable_runs, if(r.route == 'swa', r.length, 0))"
    },
    {
      "id": "cable_total",
      "expr": "cable_clipped + cable_fished + cable_swa"
    },
    {
      "id": "cable_25",
      "expr": "sum(cable_runs, if(r.size == '2.5', r.length, 0))"
    },
    {
      "id": "cable_15",
      "expr": "sum(cable_runs, if(r.size == '1.5', r.length, 0))"
    },
    {
      "id": "cable_heavy",
      "expr": "sum(cable_runs, if(r.size == '6' || r.size == '10' || r.size == '16', r.length, 0))"
    },
    {
      "id": "is_rewire",
      "expr": "job_type == 'rewire_full' || job_type == 'rewire_partial'"
    },
    {
      "id": "is_notifiable",
      "expr": "sub_region == 'england_wales' && (job_type == 'consumer_unit' || is_rewire || job_type == 'additional_circuit' || job_type == 'ev_charger' || job_type == 'outbuilding')"
    },
    {
      "id": "needs_building_control",
      "expr": "is_notifiable && part_p_route == 'building_control'"
    },
    {
      "id": "cu_replacement",
      "expr": "job_type == 'consumer_unit' || is_rewire"
    },
    {
      "id": "bonding_units",
      "expr": "if(bonding == 'present', 0, 2)",
      "note": "Gas and water bonds — the near-universal CU-change remedial"
    },
    {
      "id": "needs_earth_rod",
      "expr": "earthing == 'tt' || (job_type == 'ev_charger' && earthing == 'tncs' && !ev_open_device)"
    },
    {
      "id": "ev_long_run",
      "expr": "job_type == 'ev_charger' && (ev_distance > 20 || needs_earth_rod)"
    },
    {
      "id": "ev_short_run",
      "expr": "job_type == 'ev_charger' && !ev_long_run"
    },
    {
      "id": "test_circuits",
      "expr": "circuit_count + new_circuit_count"
    },
    {
      "id": "price_per_point",
      "expr": "if(point_count > 0, total_price_pence / point_count, 0)"
    },
    {
      "id": "cable_unknown",
      "expr": "cable_type == 'unknown' || cable_type == 'rubber' || cable_type == 'lead'"
    },
    {
      "id": "making_good_selected",
      "expr": "count(making_good) > 0"
    },
    {
      "id": "load_check_missing",
      "expr": "(job_type == 'ev_charger' || circuit_appliance > 0) && main_fuse == 'unknown'"
    }
