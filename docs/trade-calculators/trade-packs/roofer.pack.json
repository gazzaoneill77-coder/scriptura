  "modifiers": [
    {
      "id": "steep_pitch",
      "when": "pitch == '45'",
      "factor": 1.25,
      "scope": [
        "roofing"
      ],
      "explain": "Steep pitch — roped access and slower working"
    },
    {
      "id": "complex",
      "when": "complex_roof",
      "factor": 1.25,
      "scope": [
        "roofing"
      ],
      "explain": "Complex roof — multiple hips and valleys to set out"
    },
    {
      "id": "hipped",
      "when": "roof_shape == 'hip'",
      "factor": 1.15,
      "scope": [
        "roofing"
      ],
      "explain": "Hipped roof — more cutting and detail"
    },
    {
      "id": "three_storey",
      "when": "storeys > 2",
      "factor": 1.2,
      "scope": [
        "roofing",
        "handling"
      ],
      "explain": "Three storeys or more — handling and access"
    },
    {
      "id": "slate_care",
      "when": "is_slate",
      "factor": 1.3,
      "scope": [
        "roofing"
      ],
      "explain": "Natural slate — sorting, holing and breakage"
    },
    {
      "id": "winter",
      "when": "winter_working",
      "factor": 1.2,
      "scope": [
        "roofing",
        "labour",
        "handling"
      ],
      "explain": "Winter working — short days and lost weather"
    },
    {
      "id": "restricted_loading",
      "when": "loading_access != 'clear'",
      "factor": 1.25,
      "scope": [
        "handling"
      ],
      "explain": "Restricted access for loading out"
    },
    {
      "id": "occupied",
      "when": "occupied",
      "factor": 1.05,
      "scope": [
        "labour"
      ],
      "explain": "Occupied property — protection and noise management"
    }
  ],
