  "risk": {
    "surveyConfidence": {
      "been_up": 0,
      "ground": 0.15,
      "photos": 0.25
    },
    "unknownConditions": [
      {
        "when": "timber_unknown",
        "add": 0.2,
        "explain": "Timber condition unknown until the covering is off"
      },
      {
        "when": "existing_covering == 'unknown'",
        "add": 0.15,
        "explain": "Existing covering not identified"
      },
      {
        "when": "property_age == 'pre_2000'",
        "add": 0.1,
        "explain": "Pre-2000 property — unknown build-up"
      },
      {
        "when": "complex_roof",
        "add": 0.1,
        "explain": "Complex roof — detail always takes longer than it measures"
      }
    ],
    "cap": 0.4,
    "programmeOnly": [
      {
        "when": "winter_working && !fixed_completion_date",
        "addDays": 0.15,
        "explain": "Winter — allow float for lost weather days in the programme, not the price"
      },
      {
        "when": "start_season == 'autumn' && !fixed_completion_date",
        "addDays": 0.08,
        "explain": "Autumn — some weather loss likely"
      }
    ],
    "priceVolatility": {
      "low": 0,
      "medium": 0.03,
      "high": 0.06
    }
  },
  "defaults": {
    "contingencyStance": "balanced"
  },
  "validation": [
    {
      "level": "error",
      "when": "asbestos_suspected",
      "message": "Asbestos cement suspected. This needs a survey and a licensed route before anyone strips anything — don't quote it yet."
    },
    {
      "level": "error",
      "when": "plan_area == 0 && flat_area == 0 && gutter_length == 0 && fascia_length == 0 && chimney_reflash == 0 && chimney_repoint == 0 && job_type != 'roof_repair'",
      "message": "Nothing measured yet — add a roof area or an ancillary item."
    },
    {
      "level": "warning",
      "when": "storeys > 1 && !scaffold_required",
      "message": "Above single storey with no scaffold priced. Scaffold is usually the biggest line on the job — don't absorb it."
    },
    {
      "level": "warning",
      "when": "is_reroof && ridge_system == 'mortar'",
      "message": "Mortar-only ridge on a re-roof. Dry ridge is the current standard and mortar-only may not meet BS 5534."
    },
    {
      "level": "warning",
      "when": "timber_unknown && timber_allowance == 0",
      "message": "Timber condition unknown with no allowance. Put a provisional sum on the quote rather than absorbing it."
    },
    {
      "level": "warning",
      "when": "winter_working && fixed_completion_date",
      "message": "Fixed completion date over winter. Weather risk is yours now — price it rather than leaving it in the programme."
    },
    {
      "level": "warning",
      "when": "price_per_m2 < 6000 && is_reroof",
      "message": "Under £60/m² of roof area on a re-roof. Check the pitch factor has been applied and scaffold is included."
    },
    {
      "level": "warning",
      "when": "modifier_cap_hit",
      "message": "This job hit the difficulty cap. Get up on it before you send a price."
    },
    {
      "level": "warning",
      "when": "effective_hourly_pence < settings.labour_cost_pence",
      "message": "You're charging less per hour than the work costs you."
    }
  ],
  "presentation": {
    "groups": [
      "Access and scaffold",
      "Strip out and disposal",
      "Structure and membrane",
      "Covering",
      "Ridge, verge and detail",
      "Ancillaries",
      "Materials"
    ],
    "exclusions": [
      "Removal or disturbance of asbestos-containing materials",
