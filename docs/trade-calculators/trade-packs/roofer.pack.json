  "derivations": [
    {
      "id": "pitch_factor",
      "expr": "if(pitch == '45', 1.414, if(pitch == '40', 1.305, if(pitch == '35', 1.221, if(pitch == '30', 1.155, if(pitch == '22.5', 1.082, 1.035)))))",
      "note": "Lookup table, not trigonometry — the DSL has no cos() and roofing practice uses tables"
    },
    {
      "id": "roof_area",
      "unit": "m2",
      "expr": "plan_area * pitch_factor",
      "clientFacing": true,
      "note": "The client-facing quantity. Quoting plan area under-prices a 30-degree roof by 15%."
    },
    {
      "id": "is_reroof",
      "expr": "job_type == 're_roof' || job_type == 'refelt_retile'"
    },
    {
      "id": "strip_area",
      "expr": "if(is_reroof, roof_area, 0)"
    },
    {
      "id": "batten_area",
      "expr": "if(batten_felt == 'replace_both', roof_area, 0)"
    },
    {
      "id": "membrane_area",
      "expr": "if(batten_felt != 'reuse', roof_area, 0)"
    },
    {
      "id": "covering_area",
      "expr": "if(is_reroof, roof_area, 0)"
    },
    {
      "id": "is_slate",
      "expr": "new_covering == 'slate'"
    },
    {
      "id": "tiles_per_m2",
      "expr": "if(new_covering == 'plain_tile', 60, if(new_covering == 'clay_pantile', 16, if(is_slate, 22, 10)))"
    },
    {
      "id": "tile_count",
      "expr": "covering_area * tiles_per_m2"
    },
    {
      "id": "batten_gauge_m",
      "expr": "if(new_covering == 'plain_tile', 0.100, if(is_slate, 0.150, 0.345))"
    },
    {
      "id": "batten_length",
      "expr": "batten_area / batten_gauge_m"
    },
    {
      "id": "covering_waste",
      "expr": "if(is_slate, 0.10, 0.05)"
    },
    {
      "id": "ridge_dry",
      "expr": "if(ridge_system == 'dry', ridge_length, 0)"
    },
    {
      "id": "ridge_mortar",
      "expr": "if(ridge_system == 'mortar', ridge_length, 0)"
    },
    {
      "id": "verge_dry",
      "expr": "if(verge_system == 'dry', verge_length, 0)"
    },
    {
      "id": "asbestos_suspected",
      "expr": "existing_covering == 'asbestos' || (property_age == 'pre_2000' && existing_covering == 'unknown')"
    },
    {
      "id": "flat_deck_area",
      "expr": "if(flat_deck_replace, flat_area, 0)"
    },
    {
      "id": "is_flat_job",
      "expr": "job_type == 'flat_roof' || flat_area > 0"
    },
    {
      "id": "disposal_tonnes",
      "expr": "strip_area * if(existing_covering == 'slate', 0.030, if(existing_covering == 'plain_tile', 0.065, 0.050))",
      "note": "Roof coverings are heavy — disposal is banded by weight, not volume"
    },
    {
      "id": "scaffold_required",
      "expr": "scaffold != 'none'"
    },
    {
      "id": "programme_days",
      "expr": "max(1, ceil(elapsed_days))",
      "note": "Scaffold is hired against the programme, not against labour hours — see spec v5 crewSize"
    },
    {
      "id": "scaffold_weeks",
      "expr": "max(1, ceil(programme_days / 5))"
    },
    {
      "id": "winter_working",
      "expr": "start_season == 'winter'"
    },
    {
      "id": "complex_roof",
      "expr": "roof_shape == 'complex'"
    },
    {
      "id": "timber_unknown",
      "expr": "timber_condition == 'unknown'"
    },
    {
      "id": "price_per_m2",
      "expr": "if(roof_area > 0, total_price_pence / roof_area, 0)"
    }
  ],
