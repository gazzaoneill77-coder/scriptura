  "derivations": [
    {
      "id": "total_area",
      "expr": "wall_area + floor_area"
    },
    {
      "id": "is_wet_room",
      "expr": "job_type == 'wet_room'"
    },
    {
      "id": "small_room",
      "expr": "total_area > 0 && total_area < 4"
    },
    {
      "id": "is_large_format",
      "expr": "tile_size == 'large_format'"
    },
    {
      "id": "is_mosaic",
      "expr": "tile_size == 'mosaic' || tile_material == 'mosaic'"
    },
    {
      "id": "is_stone",
      "expr": "tile_material == 'stone'"
    },
    {
      "id": "wall_tiling_area",
      "expr": "wall_area"
    },
    {
      "id": "floor_tiling_area",
      "expr": "floor_area"
    },
    {
      "id": "cut_waste_pct",
      "expr": "if(layout == 'herringbone', 0.18, if(layout == 'diagonal', 0.15, if(is_large_format, 0.08, 0.10))) + if(is_stone, 0.15, 0)",
      "note": "Layout waste plus a stone surcharge for shade sorting and breakage"
    },
    {
      "id": "adhesive_kg_m2",
      "expr": "if(is_large_format, 8, if(tile_size == '600x600' || tile_size == '300x600', 5.5, 3.5))"
    },
    {
      "id": "adhesive_kg",
      "expr": "total_area * adhesive_kg_m2 * 1.05"
    },
    {
      "id": "grout_kg",
      "expr": "total_area * if(is_large_format, 1.5, if(is_mosaic, 1.2, 0.7))"
    },
    {
      "id": "needs_overboard",
      "expr": "overboard || substrate == 'timber'"
    },
    {
      "id": "overboard_area",
      "expr": "if(needs_overboard, total_area, 0)"
    },
    {
      "id": "levelling_area",
      "expr": "if(levelling, floor_area, 0)"
    },
    {
      "id": "tanking_area",
      "expr": "if(tanking || is_wet_room, total_area, 0)"
    },
    {
      "id": "removal_area",
      "expr": "if(remove_existing, total_area, 0)"
    },
    {
      "id": "removal_render_area",
      "expr": "if(remove_existing && removal_bedded_render, total_area, 0)"
    },
    {
      "id": "removal_standard_area",
      "expr": "removal_area - removal_render_area"
    },
    {
      "id": "ufh_area",
      "expr": "if(ufh == 'electric', floor_area, 0)"
    },
    {
      "id": "levelling_clips",
      "expr": "if(is_large_format, total_area * 12, 0)"
    },
    {
      "id": "silicone_tubes",
      "expr": "ceil(silicone_length / 6)"
    },
    {
      "id": "wet_room_untanked",
      "expr": "is_wet_room && !tanking"
    },
    {
      "id": "price_per_m2",
      "expr": "if(total_area > 0, total_price_pence / total_area, 0)"
    },
    {
      "id": "estimated_days_raw",
      "expr": "max(1, ceil(total_hours / 7.5))"
    }
  ],
