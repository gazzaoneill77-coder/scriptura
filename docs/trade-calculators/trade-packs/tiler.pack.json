  "validation": [
    {
      "level": "error",
      "when": "wet_room_untanked",
      "message": "A wet room must be tanked. Add waterproofing — this is not an optional line."
    },
    {
      "level": "error",
      "when": "total_area == 0",
      "message": "Nothing measured yet — add a wall or floor area."
    },
    {
      "level": "warning",
      "when": "is_large_format && levelling_clips == 0",
      "message": "Large format tiles with no levelling system priced. Lippage on 1200 mm tiles is not fixable after the event."
    },
    {
      "level": "warning",
      "when": "is_stone && !is_wet_room && total_area > 0 && grout_type == 'cement'",
      "message": "Natural stone with cement grout — check the stone is not acid-sensitive and that a sealer goes on before grouting."
    },
    {
      "level": "warning",
      "when": "substrate == 'timber' && !needs_overboard",
      "message": "Tiling directly onto a timber floor. Overboard it, or it will crack."
    },
    {
      "level": "warning",
      "when": "price_per_m2 < 2500",
      "message": "Under £25/m² all in. Most tilers need £35–60/m² on domestic work to make money."
    },
    {
      "level": "warning",
      "when": "modifier_cap_hit",
      "message": "This job hit the difficulty cap. Worth a proper look before you send it."
    },
    {
      "level": "warning",
      "when": "effective_hourly_pence < settings.labour_cost_pence",
      "message": "You're charging less per hour than the work costs you."
    }
  ],
